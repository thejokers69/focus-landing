# Copy to .env for local Neon + Vite (never commit .env).
# After `neon link`, run `neon env pull` to fill DATABASE_* and NEON_AUTH_* from your branch.

# Runtime (pooled) — Neon Functions + app queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Migrations / drizzle-kit (direct, non-pooler)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional alias some tools expect for migrate-only URLs
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon Auth (injected on deploy; pulled locally when auth: true in neon.ts)
NEON_AUTH_BASE_URL="https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Function CORS — comma-separated browser origins (set before `neon deploy`)
# Example production: https://focus-landing.vercel.app,https://your-preview.vercel.app
ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Vite — public base URL of the deployed `api` function (no trailing slash)
# Local: run `neon dev` (default http://localhost:8787)
VITE_NEON_API_URL="http://localhost:8787"
